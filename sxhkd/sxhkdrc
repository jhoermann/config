#
# wm independent hotkeys
#

# terminal emulator
super + Return
	alacritty

# Speaker Volume control
XF86AudioRaiseVolume
	pulsemixer --max-volume 100 --change-volume +5

XF86AudioLowerVolume
	pulsemixer --max-volume 100 --change-volume -5

# Toggle mute
XF86AudioMute
	pulsemixer --toggle-mute

# Music control
XF86Audio{Next,Prev,Play,Stop}
	playerctl {next,previous,play-pause,stop}

# Calculator
XF86Calculator
    gnome-calculator

# Screenshot
super + shift + s
	flameshot gui

# Lockscreen
super + l
    betterlockscreen --lock

# program launcher
super + @space
	rofi -show run

#
# bspwm hotkeys
#

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# Reload Keybindings
super + Escape
	pkill -USR1 -x sxhkd

# close and kill
super + {_,shift + }w
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# switch to desktop 1–4 on the currently focused monitor
super + {1-4}
    bspc desktop -f focused:^{1-4}

# Send focused Node to another workspace
super + shift + {1-8}
	bspc node -d ^{1-8} --follow

# Switch workspace
ctrl + alt + {Left,Right}
	bspc desktop -f {prev,next}

# focus the last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# focus next window on current desktop
alt + Tab
    bspc node -f next.local

# focus previous window on current desktop
shift + alt + Tab
    bspc node -f prev.local

# Focus monitor 1
super + Left
    bspc monitor eDP-2 -f

# Focus monitor 2
super + Right
    bspc monitor DP-2 -f

# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}
