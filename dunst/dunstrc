[global]
    geometry = "320x60-20+40"
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 8
    corner_radius = 3
    max_icon_size = 48
    sort = false
    shrink = false
    wrap = true
    transparency = 8
    format = "<b>%s</b>\n%b"
    frame_width = 1
    separator_height = 1
    icon_position = left
    enable_recursive_icon_lookup = true

[urgency_low]
    timeout = 5
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#3B4252"
    highlight = "#88C0D0"

[urgency_normal]
    timeout = 10
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#3B4252"
    highlight = "#5E81AC"

[urgency_critical]
    timeout = 0
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
    highlight = "#BF616A"

